{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "m365-license-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "LOGS_BUCKET",
      "bucket_name": "m365-logs"
    }
  ],
  "vars": {
    "TENANT_LABEL": "YOUR_TENANT_LABEL",
    "TENANT_ID": "YOUR_TENANT_ID",
    "CLIENT_ID": "YOUR_CLIENT_ID"
  }
}
