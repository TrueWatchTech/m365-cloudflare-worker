{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "o365-unified-log-processor",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "LOG_IDS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID" // run: wrangler kv namespace create LOG_IDS_O365
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOGS_BUCKET",
      "bucket_name": "m365-logs"
    }
  ],
  "services": [
    {
      "binding": "DATAKIT",
      "service": "datakit",
      "environment": "production"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "o365-unified-log-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  }
}
